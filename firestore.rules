rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function eu(uid) { return logado() && request.auth.uid == uid; }
    // Quem o dono colocou na lista de parceiros pode ver o perfil e o feed dele.
    function parceiroDe(uid) {
      return logado() && request.auth.uid in get(/databases/$(database)/documents/perfis/$(uid)).data.get('parceiros', []);
    }
    function mudou() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Privado: configurações, plano, peso.
    match /usuarios/{uid}/{colecao}/{docId} {
      allow read, write: if eu(uid) && colecao in ['config', 'pesos'];
    }

    match /perfis/{uid} {
      allow read: if eu(uid) || parceiroDe(uid);
      allow create, delete: if eu(uid);
      // O dono muda tudo. A dupla só pode mandar uma cutucada.
      allow update: if eu(uid) || (parceiroDe(uid) && mudou().hasOnly(['cutucada']));
      // Quem tem um código válido gerado pelo dono entra na lista de parceiros (só se acrescenta).
      allow update: if logado()
        && mudou().hasOnly(['parceiros', 'convite'])
        && request.resource.data.convite is string
        && get(/databases/$(database)/documents/convites/$(request.resource.data.convite)).data.uid == uid
        && get(/databases/$(database)/documents/convites/$(request.resource.data.convite)).data.expira > request.time.toMillis()
        && request.resource.data.parceiros.toSet().difference(resource.data.get('parceiros', []).toSet()) == [request.auth.uid].toSet()
        && resource.data.get('parceiros', []).toSet().difference(request.resource.data.parceiros.toSet()).size() == 0
        && request.resource.data.parceiros.size() <= 5;
    }

    // Registro do dia, fotos das refeições e check-ins: o dono grava, a dupla lê e reage.
    match /feed/{uid}/{colecao}/{docId} {
      allow read: if (eu(uid) || parceiroDe(uid)) && colecao in ['dias', 'fotos', 'checkins'];
      allow write: if eu(uid) && colecao in ['dias', 'fotos', 'checkins'];
      allow update: if colecao == 'dias' && parceiroDe(uid) && mudou().hasOnly(['reacoes']);
    }

    // Código de dupla: cada um só cria para si, com validade curta. Ninguém lista;
    // quem sabe o código lê e apaga.
    match /convites/{cod} {
      allow get, delete: if logado();
      allow create: if logado()
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'expira'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.expira is int
        && request.resource.data.expira <= request.time.toMillis() + 1800000 + 60000;
    }

    // Desafios (estilo GymRats). Só os membros veem. Quem cria só pode colocar gente da própria dupla;
    // os outros entram com um código de entrada.
    match /desafios/{id} {
      function membros() { return request.resource.data.membros; }
      function novos() { return membros().toSet().difference(resource.data.membros.toSet()); }
      function saiu() { return resource.data.membros.toSet().difference(membros().toSet()); }
      function minhaDupla() { return get(/databases/$(database)/documents/perfis/$(request.auth.uid)).data.get('parceiros', []).toSet(); }
      function soMeuPerfil() { return request.resource.data.get('perfis', {}).diff(resource.data.get('perfis', {})).affectedKeys().hasOnly([request.auth.uid]); }
      function entrada() { return get(/databases/$(database)/documents/entradas/$(request.resource.data.entrada)).data; }

      allow read: if logado() && request.auth.uid in resource.data.membros;
      allow create: if logado()
        && request.resource.data.dono == request.auth.uid
        && request.auth.uid in membros()
        && membros().size() <= 20
        && membros().toSet().difference([request.auth.uid].toSet()).difference(minhaDupla()).size() == 0;
      // O dono edita tudo e só acrescenta gente da dupla dele.
      allow update: if logado() && resource.data.dono == request.auth.uid
        && request.resource.data.dono == request.auth.uid
        && membros().size() <= 20
        && novos().difference(minhaDupla()).size() == 0;
      // Membro atualiza o próprio nome/foto ou sai.
      allow update: if logado() && request.auth.uid in resource.data.membros
        && mudou().hasOnly(['membros', 'perfis'])
        && novos().size() == 0
        && saiu().difference([request.auth.uid].toSet()).size() == 0
        && soMeuPerfil();
      // Quem tem um código de entrada válido deste desafio se coloca na lista.
      allow update: if logado()
        && mudou().hasOnly(['membros', 'perfis', 'entrada'])
        && request.resource.data.entrada is string
        && entrada().desafio == id
        && entrada().expira > request.time.toMillis()
        && novos() == [request.auth.uid].toSet()
        && saiu().size() == 0
        && membros().size() <= 20
        && soMeuPerfil();
      allow delete: if logado() && resource.data.dono == request.auth.uid;

      // Check-ins (sem foto) e fotos: cada um grava os seus; os membros leem e reagem.
      match /{colecao}/{cid} {
        function membroD() { return logado() && request.auth.uid in get(/databases/$(database)/documents/desafios/$(id)).data.membros; }
        allow read: if membroD() && colecao in ['checkins', 'fotos'];
        allow create: if membroD() && colecao in ['checkins', 'fotos'] && request.resource.data.uid == request.auth.uid;
        allow update: if membroD() && colecao in ['checkins', 'fotos'] && (
          (resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid)
          || (colecao == 'checkins' && mudou().hasOnly(['reacoes'])
              && request.resource.data.get('reacoes', {}).diff(resource.data.get('reacoes', {})).affectedKeys().hasOnly([request.auth.uid])));
        allow delete: if logado() && colecao in ['checkins', 'fotos'] && resource.data.uid == request.auth.uid;
      }
    }

    // Código para entrar num desafio: só um membro cria, vale até 7 dias. Ninguém lista.
    match /entradas/{cod} {
      allow get: if logado();
      allow delete: if logado() && resource.data.uid == request.auth.uid;
      allow create: if logado()
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'desafio', 'expira'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.expira is int
        && request.resource.data.expira <= request.time.toMillis() + 7 * 86400000 + 60000
        && request.auth.uid in get(/databases/$(database)/documents/desafios/$(request.resource.data.desafio)).data.membros;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
